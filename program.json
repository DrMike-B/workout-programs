  "infoText": {
    "about": "Showing up is the goal. After 50, consistency is more important than sets or reps. Keep moving, stay injury-free, feel good doing it.",
    "setsAndReps": "I usually do 3 sets with a 1/2 weight add-on finisher. Somewhere between 10 and 15 reps where the last few feel like work but form never breaks. Rest usually 2 minutes per set.",
    "floor": "Three movements per session. Primary option first, alternative after the slash — use whichever is free. No supersets, no circuits. Do your sets, rest, move on.",
    "burnout": "Optional. Drop your main compound to 50–60% of working weight and take it to failure. Aim for 20–30 reps. Maintains muscle without heavy loading.",
    "mat": "Over time you should develop your own stretch and core routine using the suggestions here. What we suggest here augments what you already know. The hamstring stretch is a daily constant. Everything else rotates. Props are always optional.",
    "whenToGo": "No streaks. No guilt. The app picks up exactly where you left off — tomorrow or next week, it does not matter."
  },
  "skills": {
    "handstand": {
      "name": "Handstand",
      "rules": {
        "moveOn": "Hit the target with clean form 2 sessions in a row.",
        "regress": "Pain, a giving-out feeling, form breaking down, or can't reach the bottom of the range."
      },
      "phases": [
        {
          "id": 1,
          "name": "Phase 1: Foundation",
          "status": "active",
          "goal": "Straight-arm shoulder stability, overhead strength, core line and wrist tolerance before going inverted.",
          "warmup": [
            "Wrist circles: 10 each direction",
            "Wrist rocks on all fours: 10 fingers forward, 10 back",
